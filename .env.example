# 이 파일을 .env 로 복사한 뒤 값을 채워 주세요. (.env 는 git에 올라가지 않습니다)

# YouTube Data API v3 키 (Google Cloud Console)
YOUTUBE_API_KEY=

# Reddit API 앱 (https://www.reddit.com/prefs/apps 에서 "script" 앱 생성)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=issue-radar/0.1 by <레딧아이디>

# Claude API 키 (이슈 묶기·브리프 작성용, 2단계)
ANTHROPIC_API_KEY=

# 네이버 개발자센터 앱 (검색 + 데이터랩) — https://developers.naver.com/apps
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
